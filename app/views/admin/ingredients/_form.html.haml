= form_with(model: [:admin, @ingredient], data: {turbo: false}, class: "space-y-6") do |f|

  - if @ingredient.errors.any?
    #error_explanation.p-4.m-4.border-2.border-red-400.rounded-lg
      %h2.text-red-500.text-lg.font-semibold= "#{pluralize(@ingredient.errors.count, "error")} prohibited this ingredient from being saved:"
      %ul.p-4
        - @ingredient.errors.full_messages.each do |message|

          %li= message
  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Name
      %div.mt-1
        = f.text_field :name, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-2
      %label.block.text-sm.font-medium.text-gray-700 Describtion
      %div.mt-1
        = f.rich_text_area :description, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-2
      %label.block.text-sm.font-medium.text-gray-700{:for => "multiple_files"} Images
      %div.mt-1
        = f.file_field :images, multiple: true, class: "block w-full form-input text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none"

      
      

  .flex.justify-end
    = f.submit 'Save', class: "btn bg-green-600 text-white px-4 py-2 rounded-md", disabled_with: "Please wait..."