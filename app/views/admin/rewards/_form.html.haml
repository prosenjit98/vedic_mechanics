= form_with(model: [:admin, @admin_reward], data: {turbo: false}, class: "space-y-6") do |f|
  - if @admin_reward.errors.any?
    #error_explanation.p-4.m-4.border-2.border-red-400.rounded-lg
      %h2.text-red-500.text-lg.font-semibold= "#{pluralize(@admin_reward.errors.count, "error")} prohibited this reward from being saved:"
      %ul.p-4
        - @admin_reward.errors.full_messages.each do |message|
          %li= message

  .grid.grid-cols-1.gap-6
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Name
      %div.mt-1
        = f.text_field :name, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Description
      %div.mt-1
        = f.text_field :description, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Validity
      %div.mt-1
        = f.number_field :validity, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Points
      %div.mt-1
        = f.number_field :points, class: "form-input block w-full border-gray-300 rounded-md shadow-sm"
    .col-span-1
      %label.block.text-sm.font-medium.text-gray-700 Image
      %div.mt-1
        = f.file_field :image, class: "block w-full form-input text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none"
    .col-span-1
      -# %input#default-checkbox.w-4.h-4.text-blue-600.bg-gray-100.border-gray-300.rounded-sm.focus:ring-blue-500.dark:focus:ring-blue-600.dark:ring-offset-gray-800.focus:ring-2.dark:bg-gray-700.dark:border-gray-600{:type => "checkbox", :value => ""}/
      -# %label.ms-2.text-sm.font-medium.text-gray-900.dark:text-gray-300 Default checkbox
      = f.check_box :is_active, class: "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded-sm focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
      %label.text-sm.font-medium.text-gray-700{:for => "is_active"} Is Active
  .flex.justify-end
    = f.submit @admin_reward.new_record? ? 'Create Reward' : 'Edit Reward', class: "btn bg-green-600 text-white px-4 py-2 rounded-md"
