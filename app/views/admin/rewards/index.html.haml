.relative.overflow-x-auto.shadow-md.sm:rounded-lg(data-controller="global-modal reward")
  .flex.items-center.justify-between.flex-column.md:flex-row.flex-wrap.space-y-4.md:space-y-0.p-4.bg-white
    %div
    = link_to new_admin_reward_path , class: "border border-green-500 bg-white hover:bg-green-500 hover:text-white text-green-500 font-medium py-2 px-8 rounded-xl ", data: { turbo: false} do
      = heroicon 'plus',variant: :solid , options: {class: "w-5 h-5 inline-block "} 
      %span.py0.px-0.text-sm Add new
  = render 'table'


  #global_model_id.hidden.fixed.inset-0.bg-black.bg-opacity-80.flex.items-center.justify-center.z-50{"data-global-modal-target" => "clickShow"}
    .relative.rounded-lg.p-4.shadow-lg.max-h-full.bg-white{class: 'w-1/2 h-3/5'}
      %div.p-4.flex.justify-between.items-center.border-b
        %h3.text-xl.font-semibold.text-gray-900 Add User
        %button.absolute.top-2.right-2.text-white.text-lg.font-bold.cursor-pointer{"data-action" => "click->global-modal#close"} ✕
      .w-full.h-full
        = form_with(model: [:admin, Reward], url: add_users_admin_rewards_path, data: {turbo: false}, class: "space-y-6") do |f|
          = f.hidden_field :id
          .grid.grid-cols-1.gap-6
            .col-span-1 
              = f.label :user_ids, "Users", class: "block mb-2 text-sm font-medium text-gray-900"
              = f.select :user_ids, options_for_select(User.all.collect{|e| [e.full_name, e.id]}),{include_blank: true, multiple: true}, class: 'selectable focus:ring-green-500 focus:border-green-500'

          .flex.justify-end
            = f.submit 'submit', class: "btn bg-green-600 text-white px-4 py-2 rounded-md"



        

