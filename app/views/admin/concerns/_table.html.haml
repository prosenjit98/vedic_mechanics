%table.w-full.text-sm.text-left.rtl:text-right.text-gray-500
  %thead.text-xs.text-gray-700.uppercase.bg-gray-50
    %tr
      %th.p-4{:scope => "col"}
        = "#id"
      %th.px-6.py-3{:scope => "col"}
        Name
      %th.px-6.py-3{:scope => "col"}
        Description 
      %th.px-6.py-3{:scope => "col"}
  %tbody
    - @concerns.each do |concern|
      %tr.bg-white.border-b.hover:bg-gray-200
        %td.w-4.p-4= concern.id
        %th.px-6.py-4.text-gray-900.whitespace-nowrap= concern.name
        %td.px-6.py-4.text-gray-900.whitespace-nowrap= concern.description
        %td.px-6.py-4
          = link_to "Edit", edit_admin_concern_path(concern), class: "font-medium text-green-500 hover:underline"
:css
  .show-on-hover {
    opacity: 0;
    transition: opacity .2s ease-in-out;
  }
  .show-on-hover:hover {
    opacity: 1;
  }
  .hide-on-hover {
    opacity: 1;
    transition: opacity .2s ease-in-out;
  }
  .hide-on-hover:hover {
    opacity: 0;
  }
      