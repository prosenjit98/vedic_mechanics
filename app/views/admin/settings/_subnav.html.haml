.text-sm.font-medium.text-center.text-gray-500.border-b.border-gray-200.dark:text-gray-400.dark:border-gray-700
  %ul.flex.flex-wrap.-mb-px
    %li.me-2
      = active_link_to 'Banner', banner_admin_settings_path, active: [['admin/settings'], ['banner']], class: "inline-block p-4 border-b-2 rounded-t-lg #{i == 0 ? "text-blue-600 border-blue-600 active dark:text-blue-500 dark:border-blue-500" : "" }"
    %li.me-2
      = active_link_to 'Trending Search', "#", active: [['admin/settings'], ['trending']], class: "inline-block p-4 border-b-2 rounded-t-lg #{i == 1 ? "text-blue-600 border-blue-600 active dark:text-blue-500 dark:border-blue-500" : "" }"
    %li.me-2
      = active_link_to 'Other Settings', other_settings_admin_settings_path, active: [['admin/settings'], ['other_settings']], class: "inline-block p-4 border-b-2 rounded-t-lg #{i == 2 ? "text-blue-600 border-blue-600 active dark:text-blue-500 dark:border-blue-500" : "" }"