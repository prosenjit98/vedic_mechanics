.relative.bg-white.rounded-lg.shadow
  .flex.items-center.justify-between.p-4.md:p-5.border-b.rounded-t
    %h3.text-xl.font-semibold.text-gray-900
      Review Payment
  .p-4.md:p-5
    .space-y-4
      = form_for([:admin, @payment], data: { turbo: false }) do |f|
        - if @payment.errors.any?
          .bg-red-100.border.border-red-400.text-red-700.px-4.py-3.rounded.relative(role="alert")
            %strong.font-bold Errors:
            %span.block.sm:inline There were problems with the following fields:
            %ul.mt-2.ml-4.list-disc.list-inside
              - @payment.errors.full_messages.each do |message|
                %li= message
        -# = f.hidden_field :external_user_id
        - @cart = @payment.cart
        .grid.grid-cols-1.gap-4.mx-4
          .text-gray-500.text-lg.font-semibold Order details
          .grid.grid-cols-1
            %div.bg-gray-100.mx-4.my-4.rounded
              - @payment.cart.cart_items.each do |item|
                .grid.grid-cols-1.gap-4.mx-4.my-4
                  .flex.justify-between
                    %div 
                      %h3.font-semibold.text-gray-600.text-sm= item.product&.name_or_code
                      %p.text-base.font-normal.text-gray-500.text-xs 
                        %span (price : 
                        %span.price{data: {amount: item.product.price}} #{item.product.price.round(2)}
                        %span= "*  #{item.quantity} )"
                    %div
                      %h3.text-gray-900.price{data: {amount: item.price}}= number_to_currency(item.price, precision: 0, unit: "Rs. ")
              %hr.h-px.my-4.bg-gray-900.border-1
              %div.flex.justify-between.text-lg.font-semibold.text-gray-900.px-4
                %span Sub total
                %span.price{data: {amount: @cart.total_price}}= number_to_currency(@cart.total_price, precision: 0, unit: "Rs. ")
              - if @cart && (@cart.price_with_gst.to_f - @cart.total_price <= 0)
                %div.flex.justify-between.text-sm.text-black-500.px-4
                  %span GST
                  %span.price{data: {amount: (@cart.price_with_gst.to_f - @cart.total_price)}}= number_to_currency((@cart.price_with_gst.to_f - @cart.total_price), unit: "Rs. ")
              %hr.h-px.my-4.bg-gray-200.border-1.dark:bg-gray-900
              %div.flex.justify-between.text-lg.font-semibold.text-gray-900.px-4.mb-4
                %span Total
                %span.price{data: {amount: @cart.price_with_gst.to_f}}= number_to_currency(@cart.price_with_gst, unit: "Rs. ")

        .grid.grid-cols-1
          .text-gray-500.text-lg.font-semibold User Payment Details
          .grid.grid-cols-2.p-6
            %div
              .grid.grid-cols-2
                %div Phone number
                %div= @payment.user&.phone_number
              .grid.grid-cols-2
                %div Email
                %div= @payment.user&.email 
              .grid.grid-cols-2
                %div Name
                %div= @payment.user&.full_name
            %div
              - if @payment.payment_proof.attached?
                = image_tag @payment.payment_proof, class: "w-full h-52 object-contain"
          = f.hidden_field :status, value: 'captured'
        - if (!@payment.captured?)
          %button.text-white.bg-green-500.hover:bg-green-800.focus:ring-4.focus:outline-none.focus:ring-green-300.font-medium.rounded-lg.text-sm.px-5.my-4.text-center{class: "py-2.5", type: "submit"} Complete Payment
        = link_to "Back", admin_payments_path, class: 'px-5'