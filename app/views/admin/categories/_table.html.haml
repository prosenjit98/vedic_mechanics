%div.w-full.text-sm.text-gray-700
  %div.text-gray-800.font-medium.uppercase.bg-gray-50.px-4.py-2.rounded-md.shadow-sm
    Categories
  = turbo_frame_tag "categories" do
    = render partial: 'admin/categories/new_category', collection: @mother_categories, as: :category

:javascript
  function toggleAccordion(id) {
    const element = document.getElementById(id);
    element.classList.toggle('hidden');
    const icon = document.getElementById(`icon-${id}`);
    icon.classList.toggle('rotate-180');
  }
