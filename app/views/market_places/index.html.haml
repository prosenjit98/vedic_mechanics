= form_tag market_places_path, :method => 'get', :class => "filter-form", data: { controller: "filter", turbo_stream: true, turbo: true } do
  .grid.grid-cols-9.gap-0.pr-4.py-8.no-scrollbar
    .col-span-9.lg:col-span-2
      = render 'products/filters'
    .col-span-9.lg:col-span-7.no-scrollbar
      -# .flex.justify-between.items-center.py-4
      -#   .w-full.flex.justify-between
      -#     = text_field_tag 'search', params[:search], placeholder: "Search for Products", class: "form-input w-full md:w-1/2 px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:placeholder-gray-500 dark:text-gray-100", data: { filter_target: "filterinput" }
  
      %div.container.mx-auto.px-4.mt-4
        = turbo_frame_tag "products_list", src: market_places_url(page: params[:page], category_id: params[:category_id], product_id: params[:product_id], concern: params[:concern], ingredient: params[:ingredient], parent_category: params[:parent_category], format: :turbo_stream), loading: "lazy", data: {turbo_action: "advance"} do
          %div.grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-4#products_placeholder
            - 3.times do
              = render 'prod_skeleton'

      = turbo_frame_tag "products_pagination", data: {turbo_action: "advance"} do
        .flex.mt-12.items-center.justify-center.space-x-4.w-full
          != pagy_nav(@pagy)


    %div.hidden.fixed.inset-0.bg-gray-800.bg-opacity-50.z-30.flex.items-center.justify-center{ id: "modal", "data-filter-target": "container" }
      %div.bg-white.rounded-lg.shadow-lg.w-full.max-w-3xl.overflow-auto.max-h-96
        %div.p-4.flex.justify-between.items-center.border-b
          %h3.text-xl.font-semibold.text-gray-900 Details
          .text-gray-400.hover:text-gray-600{"data-action": "click->filter#close"}
            %svg.h-6.w-6{ xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor" }
              %path{ d: "M6 18L18 6M6 6l12 12", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2" }

        %div.p-6
          %p.text-gray-700{"data-filter-target": "content"} Default description text.

        -# %div.flex.justify-end.p-4.border-t
        -#   %button.bg-gray-200.text-gray-700.py-2.px-4.rounded.hover:bg-gray-300{"data-action": "click->filter#close"} Close
    -# #p-description.absolute.z-10.invisible.inline-block.px-3.py-2.text-sm.font-medium.text-gray-900.bg-white.border.border-gray-200.rounded-lg.shadow-sm.opacity-0.tooltip{role: "tooltip"}
    -#   Tooltip content
