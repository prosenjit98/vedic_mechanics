%div.bg-white.dark:bg-gray-800.shadow-md.rounded-lg.overflow-hidden.relative{id: "#{dom_id(product)}"}
  -# - if product.discount.present?
  -#   %span.absolute.top-0.left-0.bg-red-500.text-white.px-2.py-1.text-xs.font-bold.uppercase
  -#     Save #{product.discount}%
  %div.relative.mt-4
    = render 'products/image_gallery', { product: product }
    -# = link_to product_path(product), data: {turbo: false} do
    -#   - if product.product_images.attached?
    -#     = image_tag product.product_images.first, class: "w-full h-52 object-contain object-center mt-8 hover:opacity-75"
  %div.p-4
    -# = link_to product_path(product), data: {turbo: false} do
    .text-sm.mt-1= product.display_category.present? ? product.display_category : product.get_parent_categories(params[:parent_category])&.reverse&.join(" > ")
    .h-8.mt-1.font-bold.text-gray-800.dark:text-gray-100.hover:text-gray-500
      %i.text-sm.font-normal Name/Code:
      - if product.name.present?
        = product.name 
        - if product.product_code.present?
          %span.text-sm (#{product.product_code})
      - else 
        = product.product_code
    -# %div.cursor-pointer.bg-green-600.text-white.p-1.mx-1.rounded.hover:bg-green-800{ data: {"action": "click->filter#open", "modal-content": product.description, "modal-type": "description", "tooltip-target": "description-#{product.id}"}}
    -#     = heroicon 'information-circle', variant: :solid , options: {class: "w-5 h-5 inline-block "} 
    -#   %div.cursor-pointer.bg-green-600.text-white.py-1.px-1.mx-1.rounded.hover:bg-green-800{ data: {"action": "click->filter#open", "modal-content": product.specification, "modal-type": "specification", "tooltip-target": "specification-#{product.id}"}}
    -#     = heroicon 'newspaper', variant: :solid , options: {class: "w-5 h-5 inline-block "} 
    %div.flex.justify-center
      %div.cursor-pointer.text-blue-600.mx-1.rounded.hover:text-blue-800{ data: {action: "click->filter#open", "modal-content": generate_description(product), "modal-type": "description", "tooltip-target": "description-#{product.id}"}}
        = heroicon 'information-circle', variant: :solid , options: {class: "w-8 h-8 inline-block"}
      %div.cursor-pointer.text-white.mx-1.pt-1.rounded.hover:bg-grey-300{ data: {action: "click->filter#open", "modal-content": generate_specification(product), "modal-type": "specification", "tooltip-target": "specification-#{product.id}"}}
        = inline_svg "paper.svg", class: "w-6 h-6 inline-block"
    
        
    -# %div.flex.items-center.mt-2
    -#   %span.text-yellow-400.text-sm
    -#     - ratings = product&.product_ratings
    -#     = (1..5).map { |i| ratings >= i ? "★" : "☆" }.join(' ')
    -#   %span.text-gray-600.dark:text-gray-400.text-sm.ml-2
    -#     = "#{ratings.to_f} (#{product&.review_count} reviews)"
    -#   %div.underline.cursor-pointer{"data-action": "click->filter#openReviews", "data-product-id": product.id, "data-modal-type": "reviews"}
    -#     Details
    %div.mt-2
      - if product.unit_cost.present?
        %span.font-bold.text-red-500.price{data: {amount: product.unit_cost&.round}}
          = number_to_currency(product.unit_cost&.round, precision: 0, unit: "Rs. ")
        %span.text-sm.text-gray-600 x #{product.units_per_batch}(min qty) = 
        %span.font-bold.text-red-500.price.p-0{data: {amount: product.price&.round}}
          = number_to_currency(product.price&.round, precision: 0, unit: "Rs. ")
        - if product.discount > 0
          %span.text-sm.text-gray-600.dark:text-gray-400.line-through.price.p-0{data: {amount: product.original_price&.round}}
            = number_to_currency(product.original_price.round, precision: 0, unit: "Rs. ")
      - else
        %span.font-bold.text-red-500.price{data: {amount: product.price&.round}}
          = number_to_currency(product.price.round, precision: 0, unit: "Rs. ")
        - if product.discount > 0
          %span.text-sm.text-gray-600.dark:text-gray-400.line-through.ml-2.price{data: {amount: product.original_price&.round}}
            = number_to_currency(product.original_price.round, precision: 0, unit: "Rs. ")
    %button.mt-4.w-full.inline-block.bg-gradient-to-r.from-blue-500.to-indigo-900.text-white.px-4.py-2.rounded-lg.text-center.shadow-lg.hover:from-indigo-900.hover:to-blue-700.focus:outline-none.focus:ring.focus:ring-blue-200.focus:ring-opacity-50.transition-transform.transform.hover:scale-105{'data-action': "click->cart#addToCart", 'data-product-id': "#{product.id}"}
      = heroicon 'plus', variant: :solid , options: {class: "w-5 h-5 inline-block "} 
      = heroicon 'shopping-cart', variant: :solid , options: {class: "w-5 h-5 inline-block "} 
      -# Add to Cart
      -# = heroicon 'arrow-right-end-on-rectangle', variant: :micro , options: {class: "w-5 h-5 inline-block ml-2"} 
    %div.hidden
      = render 'products/review_question', {product: product}
    .absolute.z-10.invisible.inline-block.px-3.py-1.text-sm.font-medium.text-gray-900.bg-white.border.border-gray-200.rounded-lg.shadow-sm.opacity-0.tooltip{role: "tooltip", id: "description-#{product.id}"}
      Description
      .tooltip-arrow{data: "popper-arrow"}
    .absolute.z-10.invisible.inline-block.px-3.py-1.text-sm.font-medium.text-gray-900.bg-white.border.border-gray-200.rounded-lg.shadow-sm.opacity-0.tooltip{role: "tooltip", id: "specification-#{product.id}"}
      Specification
      .tooltip-arrow{data: "popper-arrow"}