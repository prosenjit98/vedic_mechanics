#default-carousel.relative.w-full{"data-carousel" => "static", "data-controller" => "tabs"}
  .relative.h-56.overflow-hidden.rounded-lg.md:h-60
    - product.product_images.each_with_index do |image, index|
      - if product.is_image?(image)
        .hidden.bg-white.dark:bg-gray-700.duration-700.ease-in-out{"data-carousel-item" => ""}
          = image_tag image, alt: product.name, class: "-translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2 absolute block object-contain w-full h-full"
      - elsif product.is_video?(image)
        .hidden.bg-white.dark:bg-gray-700.duration-700.ease-in-out{"data-carousel-item" => ""}
          = video_tag image, controls: true, class: "-translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2 absolute block object-contain w-full h-full"
    
  / Slider indicators
  .absolute.z-30.flex.space-x-3.rtl:space-x-reverse.px-1.py-1.rounded.indicator{:class => "-bottom-4 -translate-x-1/2 left-1/2 dark:bg-gray-100/50"}
    - product.product_images.each_with_index do |image, index|
      %button.w-2.h-2.rounded-full.bg-red-500{"aria-current" => index == 0 ? "true" : "false", "aria-label" => "Slide #{index + 1}", "data-carousel-slide-to" => "0", "data-tabs-target" => "indicator", :type => "button"}

  / Slider controls
  %button.prev-btn.absolute.top-0.start-0.z-30.flex.items-center.justify-center.h-full.px-4.cursor-pointer.group.focus:outline-none{"data-carousel-prev" => "", :type => "button", "data-action" => "click->tabs#prevBtn", "data-tabs-target" => "prev"}
    %span.inline-flex.items-center.justify-center.w-10.h-10.rounded-full.group-focus:outline-none{:class => "dark:group-hover:bg-gray-500/60 dark:group-focus:ring-gray-800/70"}
      %svg.w-3.h-3.text-black-500.dark:text-white.rtl:rotate-180{"aria-hidden" => "true", :fill => "none", :viewbox => "0 0 6 10", :xmlns => "http://www.w3.org/2000/svg"}
        %path{:d => "M5 1 1 5l4 4", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "1"}
      %span.sr-only Previous
  %button.next-btn.absolute.top-0.end-0.z-30.flex.items-center.justify-center.h-full.px-4.cursor-pointer.group.focus:outline-none{"data-carousel-next" => "", :type => "button", "data-action" => "click->tabs#nextBtn", "data-tabs-target" => "next"}
    %span.inline-flex.items-center.justify-center.w-10.h-10.rounded-full.group-focus:outline-none{:class => "dark:group-hover:bg-gray-500/60 dark:group-focus:ring-gray-800/70"}
      %svg.w-3.h-3.text-black-500.dark:text-white.rtl:rotate-180{"aria-hidden" => "true", :fill => "none", :viewbox => "0 0 6 10", :xmlns => "http://www.w3.org/2000/svg"}
        %path{:d => "m1 9 4-4-4-4", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "1"}
      %span.sr-only Next


:css
  button[aria-current=true]{
    background-color: #1e1111 !important;
  }
  button[aria-current=false]{
    background-color: #8e9c9463 !important;
  }


