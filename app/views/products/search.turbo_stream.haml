= turbo_stream.update("search_results") do
  - if @products.present?
    %div.bg-white.w-full.p-4.shadow-md.rounded-lg.final_product_result{class: 'w-full'}
      .grid.grid-cols-4.md:grid-cols-8.lg:grid-cols-12.gap-1
        - @products.each do |product|
          %div 
            = link_to market_places_path(product_id: product.id), class: "bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-semibold me-2 p-1 rounded dark:bg-gray-700 dark:text-blue-400 border border-blue-400 flex items-center flex-col justify-center", data: {turbo_stream: false, turbo: false} do
              = image_tag product.product_images.first, class: "w-16 h-16"
              %div= product&.name_or_code
          -# = link_to product.name, products_path(product_id: product.id), class: "bg-blue-100 hover:bg-blue-200 text-blue-800 text-xs font-semibold me-2 p-1 rounded dark:bg-gray-700 dark:text-blue-400 border border-blue-400 inline-flex items-center justify-center", data: {turbo_stream: true, controller: "product-search", action: "click->product-search#remove"}
          -# %a.bg-blue-100.hover:bg-blue-200.text-blue-800.text-xs.font-semibold.me-2.rounded.dark:bg-gray-700.dark:text-blue-400.border.border-blue-400.inline-flex.items-center.justify-center{:class => "px-2.5 py-0.5", :href => "#"}= product.name