%div.container.mx-auto.p-4
  %h1.text-2xl.font-bold.mb-4.text-center.pt-6 Learn about Our Products and Ingredients

  %div.mb-4
    = form_with( url: ingredients_path, data: { turbo: false }, method: :get) do |f|
      
      %div.relative.flex{data: { controller: "ingredient"}}
        = f.text_field :ing_search, value: params[:ing_search], placeholder: "Please write Product Name/Code or Ingredient Name...", id: "#ingredient-search", class: "py-2 pl-10 placeholder-gray-500 text-gray-700 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 px-3 py-2 placeholder:text-sm"
        .absolute.inset-y-0.flex.items-center.ps-3.pointer-events-none.start-0
          = heroicon 'magnifying-glass', variant: :solid, options: {class: "w-5 h-5 inline-block text-green-500 hover:text-green-700 bg-white"}
        -# %input{ type: "text", name: "ing_search", placeholder:  }
        = f.submit "Search", class: "text-white bg-blue-500 hover:bg-blue-700 font-medium rounded-lg text-sm px-5 py-2 ml-3"
        = link_to "Clear", ingredients_path, class: "text-white bg-blue-500 hover:bg-blue-700 font-medium rounded-lg text-sm px-5 py-3 ml-1"

    = link_to "<- Back to products", root_path, class: "text-white fixed left-4 bottom-4 bg-blue-500 hover:bg-blue-700 font-medium rounded-lg text-sm px-5 py-3 ml-1"
    

  -#  Loop through ingredients
  .bg-white.shadow-md.rounded-lg.mb-8.p-6
    - @ingredients.each_with_index do |ingredient, index|
      %div{id: ingredient.name.parameterize }
        %h2.text-2xl.font-semibold.mb-4.text-gray-800= ingredient.name

        - if ingredient.images.attached?
          %div.grid.grid-cols-2.md:grid-cols-8.gap-4.mb-6
            - ingredient.images.each do |image|
              %div
                = image_tag(image, alt: ingredient.name, class: "w-[150px] h-[150px] object-cover rounded-md border")

        %div.prose.max-w-full.text-gray-700{style: "font-family: 'gill sans'"}
          = ingredient.description
      - if index + 1 < @ingredients.count
        %hr.my-4
    - unless @ingredients.present?
      %h2.text-2xl.font-semibold.mb-4.text-gray-800 Ingredients not present with this search result


