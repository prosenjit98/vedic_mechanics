- if cart_items.present?
  - cart_items.each_with_index do |item, index|
    .flex 
      %div= "#{index + 1}. "
      %div.flex.justify-center.flex-grow
        .text-md.text-gray-800.dark:text-gray-100.flex-grow= item.product&.name || item.product&.product_code
        %div
          %span.text-l.font-bold.price{data: {amount: item.product.price}}= "#{number_to_currency(item.product.price, precision: 0, unit: "Rs. ")} x #{item.quantity}"
  %div 
    %hr.h-px.my-4.bg-gray-200.border-1.dark:bg-gray-700
    %div.flex.justify-between.text-sm.font-semibold.text-gray-900.dark:text-gray-100
      %span Total
      %span.price{data: {amount: cart.total_price}}= number_to_currency(cart.total_price, unit: "Rs. ")
    %hr.h-px.my-4.bg-gray-200.border-1.dark:bg-gray-700

  %div.mt-4
    = link_to "Proceed", carts_path(external_id: params[:external_user_id]), class: 'w-full bg-indigo-900 block text-white px-4 py-2 rounded-lg text-center hover:bg-indigo-800'

      
- else
  %p You don't have any product added into cart