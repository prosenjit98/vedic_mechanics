
%div.mx-auto.px-4.body_background_2.dark:bg-gray-900.w-full.h-screen.container.max-w-screen-lg
  .pt-20
    .grid.grid-cols-1.md:grid-cols-8.gap-4
      .grid-span-1.md:col-span-2
        = render 'indicator', {step: 3}
      .grid-span-1.md:col-span-6
        .flex-grow.bg-white.md:ml-4.rounded.dark:bg-gray-800.overflow-auto{style: 'max-height: 70vh;'}
          %div.p-4.text-blue-500.text-2xl.bold Payment & Book order
          %div 
            = form_with(model: @payment, url: wizard_path, method: "PATCH", data: {turbo_stream: false, turbo: false}) do |f|
              .grid.grid-cols-1
                %div.bg-gray-100.mx-4.my-4.rounded
                  - @cart.cart_items.each do |item|
                    .grid.grid-cols-1.gap-4.mx-4.my-4
                      .flex.justify-between
                        %div 
                          %h3.font-semibold.text-gray-600.text-sm= item.product&.name_or_code
                          %p.text-base.font-normal.text-gray-500.text-xs 
                            %span (price : 
                            %span.price{data: {amount: item.product.price}} #{item.product.price.round(2)}
                            %span= "*  #{item.quantity} )"
                        %div
                          %h3.text-gray-900.price{data: {amount: item.price}}= number_to_currency(item.price, precision: 0, unit: "Rs. ")
                  %hr.h-px.my-4.bg-gray-900.border-1
                  %div.flex.justify-between.text-lg.font-semibold.text-gray-900.px-4
                    %span Sub total
                    %span.price{data: {amount: @cart.total_price}}= number_to_currency(@cart.total_price, precision: 0, unit: "Rs. ")
                  - if @cart && (@cart.price_with_gst&.to_f - @cart.total_price <= 0)
                    %div.flex.justify-between.text-sm.text-black-500.px-4
                      %span GST
                      %span.price{data: {amount: (@cart.price_with_gst.to_f - @cart.total_price)}}= number_to_currency((@cart.price_with_gst.to_f - @cart.total_price), unit: "Rs. ")
                  %hr.h-px.my-4.bg-gray-200.border-1.dark:bg-gray-900
                  %div.flex.justify-between.text-lg.font-semibold.text-gray-900.px-4.mb-4
                    %span Total
                    %span.price{data: {amount: @cart.price_with_gst.to_f}}= number_to_currency(@cart.price_with_gst.to_f, unit: "Rs. ")
              .grid.grid-cols-1
                .grid.grid-cols-1.md:grid-cols-2
                  %div 
                    .max-w-2xl.mx-auto.p-6.bg-white
                      %h2.text-2xl.font-bold.mb-6.text-gray-800 Payment Guide

                      %ol.relative.border-l.border-gray-200
                        %li.mb-4.ml-6
                          %span.flex.absolute.-left-3.justify-center.items-center.w-6.h-6.bg-blue-100.rounded
                            = heroicon 'check', options: { class: "w-6 h-6"} 
                          %h3.text-lg.font-semibold.text-gray-900 Scan QR and Make Payment
                          %p.mb-4.text-sm.text-gray-500
                            Open your preferred UPI app, scan the QR code displayed on the screen, and complete the payment.
                        %li.mb-4.ml-6
                          %span.flex.absolute.-left-3.justify-center.items-center.w-6.h-6.bg-blue-100.round-full
                            = heroicon 'check', options: { class: "w-6 h-6"}
                          %h3.text-lg.font-semibold.text-gray-900 Upload Payment Screenshot
                          %p.mb-4.text-sm.text-gray-500
                            After successful payment, take a screenshot of the confirmation and upload it using the form provided.
                        %li.mb-4.ml-6
                          %span.flex.absolute.-left-3.justify-center.items-center.w-6.h-6.bg-blue-100.rounded
                            = heroicon 'check', options: { class: "w-6 h-6"} 
                          %h3.text-lg.font-semibold.text-gray-900 Claim Back and Wait
                          %p.text-sm.text-gray-500
                            Sit back and relax! Our team will review your submission and notify you once it's verified.
                    .p-6
                      %label.block.text-sm.font-medium.text-gray-700.mb-2 Upload Supporting Document
                      = f.file_field :payment_proof, class: 'block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none', accept: "image/*,application/pdf"
                  %div
                    .shadow-md.rounded-lg
                      = image_tag 'payment_qr.jpeg', class: "w-full h-80 object-contain"

              .grid.grid-col-1.p-4
                .flex.flex-row-reverse
                  = link_to 'Back', previous_wizard_path, class: "text-sm px-5 text-center py-2 text-blue bg-gray-100 hover:bg-gray-300 mx-4 rounded-lg"
                  %button.bg-green-600.hover:bg-green-700.text-white.font-medium.py-2.px-6.rounded-lg#proceed-btn
                    Proceed Now

:javascript
  document.addEventListener('DOMContentLoaded', function () {
    const fileInput = document.getElementById('payment_payment_proof');
    const proceedBtn = document.getElementById('proceed-btn');
    proceedBtn.disabled = true;
    proceedBtn.classList.add('opacity-50', 'cursor-not-allowed');
    proceedBtn.classList.remove('hover:bg-green-700');

    fileInput.addEventListener('change', function () {
      if (fileInput.files.length > 0) {
        proceedBtn.disabled = false;
        proceedBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        proceedBtn.classList.add('hover:bg-green-700');
      } else {
        proceedBtn.disabled = true;
        proceedBtn.classList.add('opacity-50', 'cursor-not-allowed');
        proceedBtn.classList.remove('hover:bg-green-700');
      }
    });
  });     


