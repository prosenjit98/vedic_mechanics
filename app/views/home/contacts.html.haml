%div.py-8.px-8.bg-gray-50.dark:bg-gray-900.transition-colors.duration-300
  %section#contact.py-16.form-section.bg-white.dark:bg-gray-800.transition-colors.duration-300.shadow-lg.rounded-lg.mt-4
    .max-w-screen-xl.mx-auto.px-4.flex.flex-col.md:flex-row.items-center
      .mb-8.md:mb-0.text-center.md:text-left{:class => "md:w-1/2"}
        %h2.text-3xl.font-bold.mb-4.text-white Have any questions?
        %h3.text-5xl.font-extrabold.mb-4.dark:text-white.text-gray-900.text-transparent.bg-clip-text.bg-gradient-to-r.from-green-400.to-blue-500 Contact us.
        %p.text-lg.mb-4.dark:text-gray-400.text-white Want to understand more about Products?
        %p.text-lg.dark:text-gray-400.text-white Get in touch with us, and one of our experts will reach out to you.
      %div{:class => "md:w-1/2"}
        = turbo_frame_tag "contact_form" do
          = form_with model: @contact, remote: true do |f|
            %div.mb-4
              = f.label :name, class: "text-lg dark:text-gray-200 text-gray-900" do 
                Name
                %span.required.text-red-500 *
              = f.text_field :name, required: true, class: "mt-1 p-3 block w-full rounded-md shadow-sm dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 focus:border-green-500 focus:ring focus:ring-green-300 focus:ring-opacity-50 transition-all duration-300"
            .relative.mb-4
              %label.block.mb-2.text-sm.font-medium.text-gray-900{ for: 'country_code' } Phone number
              .flex
                = f.select :country_code, options_for_select( ISO3166::Country.countries.map { |c| ["#{c.iso_short_name} (#{c.country_code})", "#{c.country_code}"] }, selected: "91"),{}, class: "inline-flex w-1/4 items-center rounded-l-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm text-gray-900 focus:border-green-500 dark:border-gray-600"
                = f.telephone_field :phone_number, class: "rounded-r-lg flex-grow border border-green-300 p-2.5 text-sm focus:border-green-500 focus:ring-blue-500"
            
            %div.mb-4
              = f.label :email, class: "text-lg dark:text-gray-200 text-gray-900" do
                Email
                %span.required.text-red-500 *
              = f.email_field :email, required: true, class: "mt-1 p-3 block w-full rounded-md shadow-sm dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 focus:border-green-500 focus:ring focus:ring-green-300 focus:ring-opacity-50 transition-all duration-300"

            %div.mb-4
              = f.label :message, class: "text-lg dark:text-gray-200 text-gray-900" do
                Message
                %span.required.text-red-500 *
              = f.text_area :message, required: true, class: "mt-1 p-3 block w-full rounded-md shadow-sm dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 focus:border-green-500 focus:ring focus:ring-green-300 focus:ring-opacity-50 transition-all duration-300"
            .text-center.md:text-left
              = invisible_recaptcha_tags async: true, text: 'Send Message', class: "mt-4 inline-block bg-gradient-to-r from-green-500 to-blue-500 text-white px-8 py-3 rounded-full shadow-lg hover:from-blue-500 hover:to-green-500 focus:outline-none focus:ring focus:ring-blue-200 focus:ring-opacity-50 transition-transform transform hover:scale-105"
