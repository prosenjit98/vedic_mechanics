%button.text-white.hover:text-gray-100.dark:text-gray-200.hover:bg-green-500.rounded-lg.px-2{"aria-expanded" => "false", "data-dropdown-toggle" => "language_dropdown", type: "button"}
  = heroicon 'newspaper', options: { class: "w-5 h-5" }
  #language_dropdown.z-50.hidden.my-4.text-base.list-none.bg-white.dark:bg-gray-800.divide-y.divide-gray-100.dark:divide-gray-600.rounded-lg.shadow{"data-controller": "font"}
    %ul.py-1{role: "none", "data-font-target": "menu"}
      %li
        .menuitem.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600{ data: { value: "google-sans", action: "click->font#select" } }
          %span Google Sans
      %li
        .menuitem.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600{ data: { value: "gill-sans", action: "click->font#select" } }
          %span Gill Sans
      %li
        .menuitem.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600{ data: { value: "verdana", action: "click->font#select" } }
          %span Verdana