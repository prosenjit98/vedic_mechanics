%li{class: 'block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white', 'data-popover-target': "rate-section",  "data-popover-offset": "5"}
  .block.text-gray-100.dark:text-gray-300.rounded-lg.hover:bg-green-500.hover:text-white{"data-controller" => "site-ratings"}
    = heroicon 'star', variant: :solid , options: {class: "w-6 h-6 fill-white hover:bg-green-500 hover:fill-gray-200"}
    
    #rate-section.absolute.z-10.invisible.inline-block.w-52.text-sm.text-gray-500.transition-opacity.duration-300.bg-frost-green.border.border-gray-200.rounded-lg.shadow-sm.opacity-0.dark:text-gray-400.dark:border-gray-600.dark:bg-gray-800{"data-popover" => "", "data-site-ratings-target" => "popup", :role => "tooltip"}
      .px-3.py-2.bg-green-500.border-b.border-gray-200.rounded-t-lg.dark:border-gray-600.dark:bg-gray-700.text-center
        - unless current_user.present?
          %h3.font-semibold.text-gray-900.dark:text-white Please login to Express
        - else
          %h3.font-semibold.text-gray-900.dark:text-white Please Express
      .px-3.py-2
        .flex.mt-2.justify-around
          - unless current_user.present?
            %div.text-md.font-semibold.mb-1
              -# %div Please Login to express yourself.
              %div.flex.justify-around.mt-1
                %div.flex.flex-col.justify-center.items-center
                  = inline_svg "smiling_face.svg", class: "w-8 h-8"
                  .text-md.text-green-600
                    %b{"data-site-ratings-target": 'good'}= "#{@rating_hash["excellent"]}%"
                %div.flex.flex-col.justify-center.items-center
                  = inline_svg "sad.svg", class: "w-8 h-8"
                  .text-md.text-red-500
                    %b{"data-site-ratings-target": 'bad'}= "#{@rating_hash["bad"]}%"
              = link_to new_user_session_path, data: { turbo_frame: 'global_modal_tag'} do
                %div.text-center.w-full.mt-2.text-white.bg-blue-700.hover:bg-blue-800.focus:ring-4.focus:ring-blue-300.font-medium.rounded-lg.text-xs.px-5.me-2.mb-2.py-2.dark:bg-blue-600 login
          - else 
            %div.flex.flex-col.justify-center.items-center{"data-action" => "click->site-ratings#smileClicked", "data-rate" => "3"}
              = inline_svg "smiling_face.svg", class: "w-8 h-8"
              .text-md.text-green-600
                -# Good
                %b{"data-site-ratings-target": 'good'}= "#{@rating_hash["excellent"]}%"
            %div.flex.flex-col.justify-center.items-center{"data-action" => "click->site-ratings#smileClicked", "data-rate" => "1"}
              = inline_svg "sad.svg", class: "w-8 h-8"
              .text-md.text-red-500
                -# Bad
                %b{"data-site-ratings-target": 'bad'}= "#{@rating_hash["bad"]}%"
          %div.mt-2{"data-site-ratings-target": 'commentSection'}
            %div{"data-site-ratings-target": 'commentHeading'}
            = hidden_field_tag :rate
            = text_area_tag :comment,"", {placeholder: "Write your thoughts here...", class: "w-full text-sm text-gray-900 bg-gray-50 rounded-lg border"}
            %button.w-full.mt-2.text-white.bg-blue-700.hover:bg-blue-800.focus:ring-4.focus:ring-blue-300.font-medium.rounded-lg.text-xs.px-5.me-2.mb-2.dark:bg-blue-600.dark:hover:bg-blue-700.focus:outline-none.dark:focus:ring-blue-800{:class => "py-2", :type => "button", "data-action" => "click->site-ratings#submitRating"} Submit
      %div{"data-popper-arrow" => ""}