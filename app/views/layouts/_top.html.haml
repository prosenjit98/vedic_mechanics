        = active_link_to carts_path, active: [['carts'], []], wrap_tag: :li, class_active: 'public-nav-active', wrap_class: "block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white", 'data-controller': 'root', 'data-root-target': 'link', 'data-popover-target': "cart-details",  "data-popover-offset": "5", "data-action" => "mouseenter->cart#fetchCartDetails" do
