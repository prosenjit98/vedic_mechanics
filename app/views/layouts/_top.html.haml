%nav.primary-bg.border-gray-200.dark:border-gray-700.fixed.w-full.top-0.start-0{style: 'z-index: 200;'}
  .flex.flex-wrap.items-center.justify-between.mx-auto.px-4.py-3
    %a.flex.items-center.space-x-3.rtl:space-x-reverse{:href => "/"}
      -# = image_tag 'chandra_herbal_logo.jpeg', class: "h-8"
      %span.self-center.text-2xl.font-semibold.whitespace-nowrap.text-white.dark:text-gray-200 Machinery Co.
    %button.inline-flex.items-center.p-2.ml-3.text-sm.text-gray-500.rounded-lg.md:hidden.hover:bg-gray-100.dark:text-gray-400.dark:hover:bg-gray-700{"aria-controls" => "navbar-multi-level", "aria-expanded" => "false", "data-collapse-toggle" => "navbar-multi-level", type: "button"}
      %span.sr-only Open main menu
      %svg.w-6.h-6{:fill => "currentColor", :viewBox => "0 0 20 20", :xmlns => "http://www.w3.org/2000/svg"}
        %path{:fill-rule => "evenodd", :d => "M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z", :"clip-rule" => "evenodd"}
    #navbar-multi-level.hidden.w-full.md:block.md:w-auto
      %ul.flex.flex-col.font-medium.p-4.md:p-0.mt-4.border.border-gray-100.rounded-lg.bg-gray-50.md:space-x-4.rtl:space-x-reverse.md:flex-row.md:mt-0.md:border-0.primary-bg
        = active_link_to "Home", root_path, active: [['home'], []], wrap_tag: :li, class_active: 'public-nav-active', wrap_class: 'block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white'
        = active_link_to 'Products', market_places_path, active: [['market_places'], []], wrap_tag: :li, class_active: 'public-nav-active', wrap_class: 'block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white'
        = active_link_to 'About us', "#", active: [['#'], []], wrap_tag: :li, class_active: 'public-nav-active', wrap_class: 'block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white'
        = active_link_to carts_path, active: [['carts'], []], wrap_tag: :li, class_active: 'public-nav-active', wrap_class: 'block py-2 px-3 text-white dark:text-gray-200 rounded-lg hover:bg-green-500 hover:text-white', 'data-controller': 'root', 'data-root-target': 'link' do
          .flex
            %div.px-2 Cart
            %div.relative
              = heroicon 'shopping-cart', options: { class: "w-5 h-5" }
              %div.absolute.cart-count(data-cart-target="count") 0
        - unless current_user.present?
          %li 
            .block.py-2.px-3.text-gray-100.dark:text-gray-300.rounded-lg.hover:bg-green-500.hover:text-white
              = link_to 'Sign in', new_user_session_path, data: { turbo_frame: 'global_modal_tag' }
          %li{style: "line-height: 0.5rem;"}
            %button#dark-mode-toggle.text-gray-800.hover:text-gray-400.dark:text-gray-200.hover:bg-green-500.rounded-lg.px-2{ "data-controller": "theme"}
              %span.dark:hidden
                = heroicon 'moon', variant: :solid, options: { class: "w-6 h-6" }
              %span.hidden.dark:inline
                = heroicon 'sun', variant: :solid, options: { class: "w-6 h-6" }
        - else
          %li.ml-3{style: "line-height: 0.5rem;"}
            %button#dark-mode-toggle.text-white.hover:text-gray-100.dark:text-gray-200.hover:bg-green-500.rounded-lg.px-2{ "data-controller": "theme"}
              %span.dark:hidden
                = heroicon 'moon', variant: :solid, options: { class: "w-6 h-6" }
              %span.hidden.dark:inline
                = heroicon 'sun', variant: :solid, options: { class: "w-6 h-6" }
          %li
            .flex.items-center
              .flex.items-center.ms-3
                %div
                  %button.flex.rounded-lg.focus:ring-4.focus:ring-orange-500.bg-white.dark:bg-gray-800.dark:text-gray-200.w-auto.h-10.p-2{"aria-expanded" => "false", "data-dropdown-toggle" => "dropdown-user", type: "button"}
                    = heroicon 'user-circle', variant: :solid, options: { class: "w-6 h-6 mr-1" }
                    %div= current_user.first_name
                    = heroicon 'chevron-down', variant: :solid, options: { class: "w-4 h-4 ml-1 mt-1" }
                #dropdown-user.z-50.hidden.my-4.text-base.list-none.bg-white.dark:bg-gray-800.divide-y.divide-gray-100.dark:divide-gray-600.rounded-lg.shadow
                  .px-4.py-3{role: "none"}
                    %p.text-sm.text-gray-900.dark:text-gray-200{role: "none"}
                      = current_user.full_name
                    %p.text-sm.font-medium.text-gray-900.dark:text-gray-400.truncate{role: "none"}
                      = current_user.email
                  %ul.py-1{role: "none"}
                    %li
                      .block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600
                        = link_to user_path(current_user) do
                          = heroicon 'user-circle', variant: :solid, options: { class: "w-4 h-4 mr-1 inline-block" }
                          %span Profile
                    %li
                      .block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600
                        = link_to orders_path do
                          = heroicon 'cube', variant: :solid, options: { class: "w-4 h-4 mr-1 inline-block" }
                          %span Orders
                    %li
                      .block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600
                        = link_to orders_path do
                          = heroicon 'heart', variant: :solid, options: { class: "w-4 h-4 mr-1 inline-block" }
                          %span Wishlist
                    %li
                      .block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-300.hover:bg-gray-100.dark:hover:bg-gray-600
                        = button_to destroy_user_session_path, method: :delete do
                          = heroicon 'arrow-up-tray', variant: :solid, options: { class: "w-4 h-4 mr-1 inline-block" }
                          %span Log Out
  %nav.bg-gray-50.dark:bg-gray-700
    .max-w-screen-xl.px-4.py-3.mx-auto
      .grid.grid-cols-1.md:grid-cols-2
        .flex.items-center
          %ul.flex.flex-row.font-medium.mt-0.space-x-8.rtl:space-x-reverse.text-sm
            %li
              .text-gray-900.dark:text-white.hover:underline{ "data-dropdown-toggle": "category_dropdown"} By Category
            %li
              .text-gray-900.dark:text-white.hover:underline{ "data-dropdown-toggle": "concern_dropdown"} By Concern
            %li
              .text-gray-900.dark:text-white.hover:underline{ "data-dropdown-toggle": "ingredient_dropdown"} By Ingredient
        .relative.mt-4.md:mt-0
          = render 'products/search'
          -# .absolute.inset-y-0.start-0.flex.items-center.ps-3.pointer-events-none
          -#   %svg.w-4.h-4.text-gray-500.dark:text-gray-400{"aria-hidden" => "true", :fill => "none", :viewbox => "0 0 20 20", :xmlns => "http://www.w3.org/2000/svg"}
          -#     %path{:d => "m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
          -#   %span.sr-only Search icon
          -# %input#search-navbar.block.w-full.p-2.ps-10.text-sm.text-gray-900.border.border-gray-300.rounded-lg.bg-gray-50.focus:ring-blue-500.focus:border-blue-500.dark:bg-gray-700.dark:border-gray-600.dark:placeholder-gray-400.dark:text-white.dark:focus:ring-blue-500.dark:focus:border-blue-500{:placeholder => "Search...", :type => "text"}

#category_dropdown.hidden.bg-white.divide-y.divide-gray-100.rounded-lg.shadow.dark:bg-gray-700{style: "z-index: 200"}
  .p-5.border.border-b-1.rounded-lg.rounded-t-none.border-gray-200.bg-white.dark:border-gray-700.dark:bg-gray-900
    #sidebar
      - if @categories.present?
        - @categories.each do |category|
          = render partial: 'products/category_filter', locals: { category: category, root_cat: true }
#concern_dropdown.hidden.bg-white.divide-y.divide-gray-100.rounded-lg.shadow.dark:bg-gray-700{style: "z-index: 200"}
  - if @concerns.present?
    %ul.py-2.text-sm.text-gray-700.dark:text-gray-200
      - @concerns.each do |concern|
        %li= link_to concern.name, market_places_path(concern: concern.id), class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
#ingredient_dropdown.hidden.bg-white.divide-y.divide-gray-100.rounded-lg.shadow.dark:bg-gray-700{style: "z-index: 200"}
  - if @ingredients.present?
    %ul.py-2.text-sm.text-gray-700.dark:text-gray-200
      - @ingredients.each do |ingredient|
        %li= link_to ingredient.name, market_places_path(ingredient: ingredient.id), class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"

