= turbo_frame_tag "global_modal_tag" do
  %div{"data-controller" => "global-modal"}
    .overflow-y-auto.overflow-x-hidden.fixed.top-0.right-0.left-0.justify-center.items-center.w-full.inset-0.max-h-full#global_model_id{tabindex: "-1" , style: "background-color: rgba(0,0,0,0.6); z-index: 1000;", "data-global-modal-target" => "output"}
      .absolute.p-4.w-full.max-w-3xl.max-h-full{style: "top: 50%; left: 50%; transform: translate(-50%, -50%);"}
        / Modal content
        .relative.bg-white.rounded-lg.shadow
          / Modal header
          .flex.items-center.justify-between.p-4.md:p-5.border-b.rounded-t
            %h3.text-xl.font-semibold.text-gray-900
              Your Rewards
            %button.text-gray-400.bg-transparent.hover:bg-gray-200.hover:text-gray-900.rounded-lg.text-sm.w-8.h-8.ms-auto.inline-flex.justify-center.items-center.end-2.5{data: {action: "global-modal#close"}, type: "button"}
              %svg.w-3.h-3{"aria-hidden" => "true", fill: "none", viewbox: "0 0 14 14", xmlns: "http://www.w3.org/2000/svg"}
                %path{d: "m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6", stroke: "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2"}
              %span.sr-only Close modal
          / Modal body
          .p-4.md:p-5
            .space-y-4
              %div.grid.grid-cols-1.sm:grid-cols-2.gap-6
                - @rewards.each do |reward_user|
                  - reward = reward_user.reward
                  %div.bg-white.border.rounded-lg.shadow-lg.dark:bg-gray-800.dark:border-gray-700
                    = image_tag reward.image, class: 'w-full h-48 object-content rounded-t-lg'
                    %div.p-4
                      %h3.text-xl.font-semibold.text-gray-900.dark:text-white= reward.name
                      %p.text-gray-700.dark:text-gray-300.mt-2= reward.description
                      %div.mt-4.text-sm.text-gray-600.dark:text-gray-400
                        %span.font-semibold Start Date:
                        = reward_user.start_date.strftime('%B %d, %Y')
                      %div.text-sm.text-gray-600.dark:text-gray-400
                        %span.font-semibold End Date:
                        = reward_user.end_date.strftime('%B %d, %Y')